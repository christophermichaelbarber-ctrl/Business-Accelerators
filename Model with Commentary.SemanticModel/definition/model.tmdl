model Model
	culture: en-US
	collation: Latin1_General_100_BIN2_UTF8
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DatabaseQuery"]

ref table ProductDescription
ref table accounts
ref table scenario
ref table Commentary
ref table ledger
ref table legalentitysecurity
ref table selecttimeframe
ref table layout
ref table date
ref table legalentity
ref table measuretable
ref table currency

