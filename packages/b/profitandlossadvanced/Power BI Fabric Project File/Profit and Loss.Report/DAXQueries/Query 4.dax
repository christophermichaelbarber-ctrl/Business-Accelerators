DEFINE
	VAR __DS0FilterTable = 
		TREATAS({"Full Quarter"}, 'selecttimeframe'[Time_Horizon])

	VAR __DS0FilterTable2 = 
		TREATAS({"CY  P4"}, 'date'[FiscalPeriodCP])

	VAR __DS0FilterTable3 = 
		TREATAS({"Underlying"}, 'Fx Assumptions'[Fx Assumption])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'layout'[Line_name],
			'layout'[Income_Statement_Key],
			__DS0FilterTable,
			__DS0FilterTable2,
			__DS0FilterTable3,
			"View_A2_A_Act__PY", '_Measures_Hidden'[View A2 A Act @PY],
			"v_View_A2_A_Act__PY_FormatString", IGNORE('_Measures_Hidden'[_View A2 A Act @PY FormatString]),
			"View_A2_B_Act__Fcst", '_Measures_Hidden'[View A2 B Act @Fcst],
			"v_View_A2_B_Act__Fcst_FormatString", IGNORE('_Measures_Hidden'[_View A2 B Act @Fcst FormatString]),
			"View_A2_C_Act__Plan", '_Measures_Hidden'[View A2 C Act @Plan],
			"v_View_A2_C_Act__Plan_FormatString", IGNORE('_Measures_Hidden'[_View A2 C Act @Plan FormatString]),
			"View_A2_D_PY", '_Measures_Hidden'[View A2 D PY],
			"v_View_A2_D_PY_FormatString", IGNORE('_Measures_Hidden'[_View A2 D PY FormatString]),
			"View_A2_E_Fcst_TD", '_Measures_Hidden'[View A2 E Fcst TD],
			"v_View_A2_E_Fcst_TD_FormatString", IGNORE('_Measures_Hidden'[_View A2 E Fcst TD FormatString]),
			"View_A2_F_Fcts_BU", '_Measures_Hidden'[View A2 F Fcts BU],
			"v_View_A2_F_Fcts_BU_FormatString", IGNORE('_Measures_Hidden'[_View A2 F Fcts BU FormatString]),
			"View_A2_G_Pln", '_Measures_Hidden'[View A2 G Pln],
			"v_View_A2_G_Pln_FormatString", IGNORE('_Measures_Hidden'[_View A2 G Pln FormatString]),
			"View_A2_H", '_Measures_Hidden'[View A2 H],
			"v_View_A2_H_FormatString", IGNORE('_Measures_Hidden'[_View A2 H FormatString]),
			"View_A2_I_vs_PY", '_Measures_Hidden'[View A2 I vs PY],
			"v_View_A2_I_vs_PY_FormatString", IGNORE('_Measures_Hidden'[_View A2 I vs PY FormatString]),
			"View_A2_J_vs_Fcst_TD", '_Measures_Hidden'[View A2 J vs Fcst TD],
			"v_View_A2_J_vs_Fcst_TD_FormatString", IGNORE('_Measures_Hidden'[_View A2 J vs Fcst TD FormatString]),
			"View_A2_K_vs_Fcst_BU", '_Measures_Hidden'[View A2 K vs Fcst BU],
			"v_View_A2_K_vs_Fcst_BU_FormatString", IGNORE('_Measures_Hidden'[_View A2 K vs Fcst BU FormatString]),
			"View_A2_L_vs_Pln", '_Measures_Hidden'[View A2 L vs Pln],
			"v_View_A2_L_vs_Pln_FormatString", IGNORE('_Measures_Hidden'[_View A2 L vs Pln FormatString]),
			"View_A2_M", '_Measures_Hidden'[View A2 M],
			"v_View_A2_M_FormatString", IGNORE('_Measures_Hidden'[_View A2 M FormatString]),
			"View_A2_N_vs_PY___", '_Measures_Hidden'[View A2 N vs PY, %],
			"v_View_A2_N_vs_PY____FormatString", IGNORE('_Measures_Hidden'[_View A2 N vs PY, % FormatString]),
			"View_A2_O_vs_Fcst_TD___", '_Measures_Hidden'[View A2 O vs Fcst TD, %],
			"v_View_A2_O_vs_Fcst_TD____FormatString", IGNORE('_Measures_Hidden'[_View A2 O vs Fcst TD, % FormatString]),
			"View_A2_P_vs_Fcst_BU___", '_Measures_Hidden'[View A2 P vs Fcst BU, %],
			"v_View_A2_P_vs_Fcst_BU____FormatString", IGNORE('_Measures_Hidden'[_View A2 P vs Fcst BU, % FormatString]),
			"View_A2_Q_vs_Pln___", '_Measures_Hidden'[View A2 Q vs Pln, %],
			"v_View_A2_Q_vs_Pln____FormatString", IGNORE('_Measures_Hidden'[_View A2 Q vs Pln, % FormatString])
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(501, __DS0Core, 'layout'[Income_Statement_Key], 1, 'layout'[Line_name], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'layout'[Income_Statement_Key], 'layout'[Line_name]