model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DirectLake - profitandlossadvanced_lakehouse"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["WebModelingEdit","RemoteModeling"]

annotation __TEdtr = 1

ref table accounts
ref table layout
ref table date
ref table ledger
ref table measuretable
ref table currency
ref table legalentity
ref table '__Field Paramater Self-Service Table Measures'
ref table 'Fx Assumptions'

