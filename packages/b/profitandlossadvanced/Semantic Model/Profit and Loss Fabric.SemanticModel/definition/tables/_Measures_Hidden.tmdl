				)

		changedProperty = IsHidden

	measure 'View A1 Format Fcst BU' =
			// subtotal
			VAR NCLD_filter_context_calculated_table =
			    CALCULATETABLE(
			        Layout,
			        REMOVEFILTERS( Layout ),
			        Layout[Income_Statement_Key] >= MIN( Layout[Subtotal_From] ),
			        Layout[Income_Statement_Key] <= MIN( Layout[Subtotal_To] )
			    )
			VAR indicatorsubtotal =
			    CALCULATE(
			        [Net Credit Less Debit Indicator],
			        NCLD_filter_context_calculated_table
			    )
			//percentage
			VAR numeratormax = MAX( Layout[Divide_Numerator] )
			VAR Pct_Table =
			    CALCULATETABLE(
			        Layout,
			        REMOVEFILTERS( Layout ),
			        Layout[Income_Statement_Key] >= numeratormax,
			        Layout[Income_Statement_Key] <= numeratormax
			    )
			VAR subtotalfrom =
			    CALCULATE(
			        MAX( Layout[Subtotal_From] ),
			        REMOVEFILTERS( Layout ),
			        Pct_Table
			    )
			VAR subtotalto =
			    CALCULATE(
			        MAX( Layout[Subtotal_To] ),
			        REMOVEFILTERS( Layout ),
			        Pct_Table
			    )
			VAR NCLD_filter_context_calculated_table_Pct =
			    CALCULATETABLE(
			        Layout,
			        REMOVEFILTERS( Layout ),
			        Layout[Income_Statement_Key] >= subtotalfrom,
			        Layout[Income_Statement_Key] <= subtotalto
			    )
			VAR indicatorpct =
			    CALCULATE(
			        [Net Credit Less Debit Indicator],
			        NCLD_filter_context_calculated_table_Pct
			    )
			// indicatpr
			VAR indicator =
			    COALESCE(
			        [Net Credit Less Debit Indicator],
			        indicatorsubtotal,
			        indicatorpct
			    )
			VAR varianceadj = [View A1 I vs Fcst BU] * indicator
			VAR result =
			    SWITCH(
			        TRUE( ),
			        varianceadj > 0, [Green],
			        varianceadj < 0, [Red],
			        [Gray]
			    )
			RETURN
			    result
		isHidden
		displayFolder: Field Paramaters\View A1: Overall\Formatting
		lineageTag: 5c2487c3-7064-4ec9-9512-2df886e42414

		formatStringDefinition =
				SELECTEDVALUE(
				    Layout[Format_String_Variance_Per],
				    "0;0-0;;@"
				)

		changedProperty = IsHidden

