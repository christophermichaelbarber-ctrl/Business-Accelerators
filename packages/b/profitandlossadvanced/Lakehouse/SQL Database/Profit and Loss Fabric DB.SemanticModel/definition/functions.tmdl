/// Creates the P&L Lines
function __Fn_PnL_ShowScenario =
		(
		    amount: EXPR
		) =>
		IF( ISFILTERED( Ledger ), BLANK( ), __Fn_PnL_Sum_Subtotal_and_Blanks( amount ) )
