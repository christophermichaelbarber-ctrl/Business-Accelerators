		annotation PBI_FormatHint = {"isCustom":true}

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	measure 'Var, %' = DIVIDE( [Var, #], [Basic Actuals] )
