	measure 'Basic Actuals' = __Fn_PnL_Sum_Subtotal_and_Blanks( SUM( 'ledger'[CreditlessdebitatGlobalFx]) )
		formatString: #,##0,;(#,##0,);
		displayFolder: Metrics
		lineageTag: cc97d495-cf47-4e49-a9fa-e65c267e3762

		annotation PBI_FormatHint = {"isCustom":true}

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	measure 'Basic Plan' = __Fn_PnL_ShowScenario( SUM( Scenario[Creditlessdebit] ) )
